<h2 class="page-title">SHA-512 Hash</h2>

<div class="card">
  <turbo-frame id="sha512_app">
    <%= form_with url: sha512_path, method: :post do |form| %>
      <div class="field">
        <%= form.label :text, "Text to convert" %>
        <%= form.text_field :text, value: @input_text, placeholder: "Write your string here...", autocomplete: "off" %>
      </div>

      <%= form.submit "Generate SHA-512", class: "btn btn-primary" %>
    <% end %>

    <% if @sha512_hash.present? %>
      <div class="result-block">
        <span class="result-label">Result (SHA-512):</span>
        <div class="result-box"><%= @sha512_hash %></div>
      </div>
    <% end %>
  </turbo-frame>
</div>
